# 离线Mock无需配置任何环境变量。真实接口仅在 --mode live 时读取。
AGENT_BASE_URL=https://api.example.invalid/v1
AGENT_MODEL=replace-with-your-model-name
AGENT_API_KEY=
AGENT_TIMEOUT_SECONDS=45
# 兼容接口不支持 response_format 时设为 false；返回内容仍必须是合法JSON。
AGENT_JSON_MODE=true
# DeepSeek官方接口默认关闭thinking，避免将内部思维内容用于动作输出；其他接口默认不发送此字段。
# AGENT_THINKING=disabled
